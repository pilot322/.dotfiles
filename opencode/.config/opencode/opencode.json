{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@1.6.0",
                "--isolated",
                "--chromeArg=--class=chrome-devtools-mcp",
                "--experimentalPageIdRouting",
                "--no-usage-statistics",
                "--no-performance-crux",
                "--redact-network-headers"
            ],
            "enabled": true
        }
    }
}
