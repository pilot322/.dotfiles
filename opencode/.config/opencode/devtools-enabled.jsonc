{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--isolated",
        "--chromeArg=--class=chrome-devtools-mcp",
        "--experimentalPageIdRouting",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers"
      ],
      "timeout": 30000
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
